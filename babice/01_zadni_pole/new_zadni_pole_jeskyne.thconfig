encoding utf-8
input ../../layouts
source zadni_pole.th

# Výběr pouze podzemních prostor (bez vzdálených povrchových závrtů)
select 1318.m@1318.zadni_pole
select 1303.m@1303.zadni_pole
select 1319.m@1319.zadni_pole

layout new_layout_jeskyne
  copy l_pub

  # Přírodní pastelové barvy pro speleologické výplně
  symbol-assign area blocks AUT
  symbol-assign area clay AUT
  symbol-assign area sand AUT
  symbol-assign line wall:blocks AUT
  symbol-assign point entrance AUT
  symbol-assign point stalagmite AUT
  symbol-assign point stalactite AUT

  symbol-color point entrance [75 15 15]
  symbol-color area water [15 45 75]
  symbol-color line water-flow [15 45 75]
  symbol-color area clay [55 45 35]
  symbol-color area sand [65 60 45]
  symbol-color area blocks [35 35 35]

  # Polygony a zaměření
  symbol-color line survey [65 65 65]
  symbol-hide point station
  symbol-hide point station-name
  symbol-hide point label

  # Pozice záhlaví a legendy: v severozápadním rohu s průhledným pozadím (žádné překrývání chodeb)
  map-header 2 98 nw
  map-header-bg off
  legend on
  legend-width 20 cm
  legend-columns 3

  scale-bar 20 m

  # TeX: elegantní a čitelné záhlaví pro tisk / publikaci
  code tex-map
    \legendtextheadersize={\size[16]}
    \legendtextsectionsize={\size[10]}
    \legendtextsize={\size[8]}

    \legendcontent={%
      \hsize=\legendwidth
      \color[0 0 0]\the\legendtextcolor
      \ifnortharrow\vbox to 0pt{\line{\hfil\northarrow}\vss}\fi
      
      {\the\legendtextheadersize\bf JESKYNNÍ SYSTÉM ZADNÍHO POLE}\vskip2mm
      {\size[10]\it Babická plošina \enspace|\enspace Moravský kras \enspace|\enspace k. ú. Babice nad Svitavou}\vskip1mm
      {\size[8.5]\rm 1318 Větrná propast \enspace|\enspace 1303 Dvanáctka \enspace|\enspace 1319 Devítka}\vskip3mm
      
      \ifscalebar\scalebar\vskip4mm\fi
      
      {\rightskip=0pt plus 2em\parskip=2bp\size[8]
        \everypar{\hangindent=1.5em\hangafter=1}
        {\bf Celková délka jeskyní:} \ss cca 720 m (Větrná 610 m, Dvanáctka 76 m, Devítka 35 m)\par
        {\bf Hloubka / denivelace:} \ss 124,5 m\par
        {\bf Nadmořská výška vchodů:} \ss 526--528 m n. m.\par
        {\bf Měřické práce a mapování:} \rm ZO ČSS 6-28 Babická speleologická skupina (1974-2022)\par
        {\bf Zpracování dat a kartografie:} \rm Therion (2026)\par
      }\vskip3mm
      
      {\the\legendtextsectionsize\bf VYSVĚTLIVKY}\vskip1.5mm
      {\size[7.5]\formattedlegend}\vskip2mm
      \color[0 0 0]
    }
  endcode

  doc-author "ZO ČSS 6-28 Babická speleologická skupina"
  doc-keywords "Zadní pole, Babická plošina, Moravský kras, Větrná propast, Dvanáctka, Devítka"
  doc-subject "Plán jeskynního systému Zadní pole"
  doc-title "Jeskynní systém Zadní pole - publikační mapa"

endlayout

layout new_layout_jeskyne_alt
  copy new_layout_jeskyne
  color map-fg altitude
endlayout

layout new_layout_jeskyne_tech
  copy new_layout_jeskyne
  grid bottom
  grid-size 25 25 25 m
  grid-coords off
  code tex-map
    \framethickness=0.8mm
    \legendtextheadersize={\size[16]}
    \legendtextsectionsize={\size[10]}
    \legendtextsize={\size[8]}

    \legendcontent={%
      \hsize=\legendwidth
      \color[0 0 0]\the\legendtextcolor
      \ifnortharrow\vbox to 0pt{\line{\hfil\northarrow}\vss}\fi
      
      {\the\legendtextheadersize\bf JESKYNNÍ SYSTÉM ZADNÍHO POLE}\vskip2mm
      {\size[10]\it Babická plošina \enspace|\enspace Moravský kras \enspace|\enspace k. ú. Babice nad Svitavou}\vskip1mm
      {\size[8.5]\rm 1318 Větrná propast \enspace|\enspace 1303 Dvanáctka \enspace|\enspace 1319 Devítka}\vskip3mm
      
      \ifscalebar\scalebar\vskip4mm\fi
      
      {\rightskip=0pt plus 2em\parskip=2bp\size[8]
        \everypar{\hangindent=1.5em\hangafter=1}
        {\bf Celková délka jeskyní:} \ss cca 720 m (Větrná 610 m, Dvanáctka 76 m, Devítka 35 m)\par
        {\bf Hloubka / denivelace:} \ss 124,5 m\par
        {\bf Nadmořská výška vchodů:} \ss 526--528 m n. m.\par
        {\bf Měřické práce a mapování:} \rm ZO ČSS 6-28 Babická speleologická skupina (1974-2022)\par
        {\bf Zpracování dat a kartografie:} \rm Therion (2026)\par
      }\vskip3mm
      
      {\the\legendtextsectionsize\bf VYSVĚTLIVKY}\vskip1.5mm
      {\size[7.5]\formattedlegend}\vskip2mm
      \color[0 0 0]
    }
  endcode
endlayout

export map -projection plan -output _output/new_zadni_pole_jeskyne_plan.pdf -layout new_layout_jeskyne
export map -projection plan -output _output/new_zadni_pole_jeskyne_alt.pdf -layout new_layout_jeskyne_alt
export map -projection plan -output _output/new_zadni_pole_jeskyne_tech.pdf -layout new_layout_jeskyne_tech
