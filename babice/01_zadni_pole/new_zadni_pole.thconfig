encoding utf-8
source zadni_pole.th
select zadni_pole.m@zadni_pole

layout new_layout_zadni_pole

  scale 1 250
  language cz
  transparency on
  opacity 80
  layers on

  # Čistý bílý papír pro publikaci
  color map-bg 100
  # Příjemná pastelová vápencová výplň chodeb
  color map-fg [92 88 82]

  # Znaková sada UIS s realistickými texturami
  symbol-set UIS

  symbol-assign area blocks AUT
  symbol-assign area clay AUT
  symbol-assign area sand AUT
  symbol-assign line wall:blocks AUT
  symbol-assign point entrance AUT
  symbol-assign point stalagmite AUT
  symbol-assign point stalactite AUT

  # Přírodní pastelové barvy pro speleologické výplně
  symbol-color point entrance [75 15 15]
  symbol-color area water [15 45 75]
  symbol-color line water-flow [15 45 75]
  symbol-color area clay [55 45 35]
  symbol-color area sand [65 60 45]
  symbol-color area blocks [35 35 35]

  # Polygony a zaměření: decentní, nerušící
  symbol-color line survey [65 65 65]
  symbol-hide point station
  symbol-hide point station-name
  symbol-hide point label

  # Pozice záhlaví a legendy
  map-header 0 95 nw
  map-header-bg on
  legend on
  legend-width 24 cm
  legend-columns 2

  # Měřítko a severka
  scale-bar 20 m

  # Metapost: moderní grafické měřítko a decentní polygony
  code metapost
    def s_scalebar_NEW (expr l, units, txt) = 
      begingroup
        interim warningcheck:=0;
        tmpl:=l / Scale * cm * units / 2;
      endgroup;
      pickup PenB;
      draw (-tmpl,0)--(tmpl,0);
      draw (-tmpl,0)--(-tmpl,3bp);
      draw (tmpl,0)--(tmpl,3bp);
      draw (0,0)--(0,3bp);
      begingroup
        interim labeloffset:=4bp;
        label.top(thTEX("\size[10]\rm 0"),(-tmpl,0));
        label.top(thTEX("\size[10]\rm " & decimal (l/2)),origin);
        label.top(thTEX("\size[10]\rm " & decimal (l) & "\thinspace " & txt),(tmpl,0));
      endgroup
    enddef;
    initsymbol("s_scalebar_NEW");

    def l_survey_cave (expr P) =
      T:=identity;
      pickup PenD;
      thdraw P dashed evenly withcolor (0.55, 0.55, 0.55);
    enddef;
  endcode

  symbol-assign special scale-bar NEW

  # TeX: elegantní a čitelné záhlaví pro tisk / publikaci
  code tex-map
    \legendtextsize={\size[9]}
    \legendtextheadersize={\size[18]}
    \legendtextsectionsize={\size[11]}

    \legendcontent={%
      \hsize=\legendwidth
      \color[0 0 0]\the\legendtextcolor
      \ifnortharrow\vbox to 0pt{\line{\hfil\northarrow}\vss}\fi
      
      {\the\legendtextheadersize\bf ZÁVRTOVÁ SKUPINA ZADNÍ POLE}\vskip2mm
      {\size[11]\it Babická plošina \enspace|\enspace Moravský kras \enspace|\enspace k. ú. Babice nad Svitavou}\vskip1mm
      {\size[9]\rm Jeskyně 1318 Větrná propast \enspace|\enspace 1303 Dvanáctka \enspace|\enspace 1319 Devítka}\vskip4mm
      
      \ifscalebar\scalebar\vskip5mm\fi
      
      {\rightskip=0pt plus 2em\parskip=2bp\size[9]
        \everypar{\hangindent=1.5em\hangafter=1}
        {\bf Celková délka polygonu skupiny:} \ss 934 m\par
        {\bf Hloubka / denivelace:} \ss 124,5 m\par
        {\bf Nadmořská výška vchodů:} \ss 526--528 m n. m.\par
        {\bf Měřické práce a mapování:} \rm ZO ČSS 6-28 Babická speleologická skupina (1974-2022)\par
        {\bf Zpracování dat a kartografie:} \rm Therion (2026)\par
      }\vskip4mm
      
      {\the\legendtextsectionsize\bf VYSVĚTLIVKY}\vskip2mm
      {\size[8]\formattedlegend}\vskip2mm
      \color[0 0 0]
    }
  endcode

  doc-author "ZO ČSS 6-28 Babická speleologická skupina"
  doc-keywords "Zadní pole, Babická plošina, Moravský kras, Větrná propast, Dvanáctka, Devítka"
  doc-subject "Plán závrtové skupiny Zadní pole"
  doc-title "Zadní pole - publikační mapa"

endlayout

layout new_layout_zadni_pole_alt
  copy new_layout_zadni_pole
  color map-fg altitude
endlayout

# Exporty pro publikaci s prefixem new_
export map -projection plan -output _output/new_zadni_pole_plan.pdf -layout new_layout_zadni_pole
export map -projection plan -output _output/new_zadni_pole_alt.pdf -layout new_layout_zadni_pole_alt
